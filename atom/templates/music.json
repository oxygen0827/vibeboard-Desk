{
  "manifest": {
    "id": "template-music",
    "name": "音乐播放器示例",
    "description": "固定播放页与局部滚动列表，没有音源",
    "entry": "index.html",
    "layout": "fullscreen",
    "icon": "icon.svg",
    "input": {
      "version": 1,
      "profile": "five-way",
      "back": "custom"
    }
  },
  "files": {
    "index.html": "<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>音乐播放器示例</title><style>/* ATOM shared application primitives. No network fonts or decorative effects. */\n:root{--atom-paper:#f2f2f7;--atom-ink:#1c1c1e;--atom-accent:#007aff;--atom-muted:#787a70;--atom-action:#0066d6;--atom-secondary-text:#6c6c70;--atom-line:#d9d9df;--atom-space:8px;--atom-radius:6px;--atom-font:system-ui,-apple-system,BlinkMacSystemFont,\"Noto Sans CJK SC\",\"Microsoft YaHei\",sans-serif;--atom-mono:ui-monospace,SFMono-Regular,Consolas,monospace}\nhtml,body{width:100%;height:100%;margin:0;overflow:hidden}\n.atom-app{box-sizing:border-box;background:var(--atom-paper);color:var(--atom-ink);font:400 16px/1.5 var(--atom-font);padding:16px;margin:0;height:100vh;min-height:0;overflow:hidden;display:flex;flex-direction:column}\n.atom-scroll,[data-atom-scroll]{min-height:0;overflow:auto;overscroll-behavior:contain;flex:1;touch-action:pan-y}\n.atom-app *{box-sizing:border-box}\n.atom-app h1{font-size:24px;line-height:1.25;margin:0 0 16px;font-weight:600}\n.atom-app p{margin:0 0 16px}\n.atom-button{appearance:none;font:600 16px/1.25 var(--atom-font);min-height:48px;padding:8px 16px;border:1px solid var(--atom-ink);border-radius:var(--atom-radius);background:transparent;color:var(--atom-ink);cursor:pointer;touch-action:manipulation}\n.atom-button:focus-visible{outline:2px solid var(--atom-accent);outline-offset:3px}\n.atom-button:active{background:var(--atom-line)}\n.atom-button:disabled{opacity:.45;cursor:default}\n.atom-button-primary{background:var(--atom-action);color:var(--atom-paper);border-color:var(--atom-action)}\n.atom-button-primary:active{background:var(--atom-ink);border-color:var(--atom-ink)}\n.atom-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:8px 0}\n.atom-panel{border:1px solid var(--atom-line);border-radius:0;padding:16px;margin:16px 0}\n.atom-label{color:var(--atom-secondary-text);font:400 12px/1.5 var(--atom-font)}\n.atom-number{font-family:var(--atom-mono);font-variant-numeric:tabular-nums;line-height:1.1}\n.atom-message{font-size:14px;line-height:1.5;border-left:2px solid var(--atom-accent);padding:8px 0 8px 8px;margin:16px 0}\n@media(prefers-reduced-motion:reduce){.atom-app *{animation:none!important;transition:none!important}}\n.view{height:100%;min-height:0;display:flex;flex-direction:column;gap:8px}.view[hidden]{display:none}.view h1,.view p{margin:0}.cover{width:80px;height:80px;background:var(--atom-ink);color:var(--atom-paper);font-size:48px;text-align:center;line-height:80px;flex-shrink:0}.view .atom-row{margin:0;flex-shrink:0}.view .atom-message{font-size:12px;margin:0}.atom-scroll button{display:block;width:100%;text-align:left;margin-bottom:8px}.atom-scroll{border-top:1px solid var(--atom-line);padding-top:8px}#player{position:relative}#player .cover{position:absolute;right:8px;top:64px;width:64px;height:64px;line-height:64px;font-size:40px}#player>div:not(.cover):not(.atom-row){min-height:104px;padding-top:24px;padding-right:88px}.atom-app>h1:first-child,.view>h1:first-child{padding-left:40px;min-height:32px}.view>.atom-row:first-child{padding-left:40px}</style><style data-atom-app-appearance>/* Full application surfaces. Geometry and meaningful data colors remain app-owned. */\n:root{--atom-radius:13px;--atom-muted:var(--muted);--atom-font:system-ui,-apple-system,\"Noto Sans CJK SC\",sans-serif;--app-surface:var(--card,#fff);--app-text:var(--ink,#1c1c1e)}\nbody{font-family:var(--atom-font)!important;-webkit-font-smoothing:antialiased;background:var(--bg)!important;color:var(--ink)!important;letter-spacing:-.2px}\nh1{font-family:var(--atom-font)!important;font-size:25px!important;line-height:1.2;letter-spacing:-.8px!important;font-weight:700!important}h2{font-family:var(--atom-font)!important;font-weight:600;letter-spacing:-.3px}button,input,select,textarea{font-family:var(--atom-font)!important;box-sizing:border-box}button{border:0!important;border-radius:13px!important;background:var(--app-surface)!important;color:var(--accent)!important;box-shadow:0 1px 2px #00000005;transition:transform 140ms ease,background-color 140ms ease}button:active{transform:scale(.97);background:var(--line)!important}button.primary,button.atom-button-primary,button[aria-pressed=true],button.active,button.selected{background:var(--accent)!important;color:#fff!important}button:disabled{opacity:.38!important;box-shadow:none}button.danger{color:#d93838!important;background:var(--card)!important}input:not([type=range]):not([type=checkbox]):not([type=radio]):not([type=color]),select,textarea{background:var(--card)!important;color:var(--ink)!important;border:0!important;border-radius:12px!important;box-shadow:none!important}input[type=range],input[type=checkbox],input[type=radio]{accent-color:var(--accent)}button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:2px solid var(--accent)!important;outline-offset:3px}.atom-panel,.panel,.card{background:var(--card)!important;border:0!important;border-radius:16px!important;box-shadow:0 2px 8px #00000004}.atom-label,.subtitle,.hint,.sub{color:var(--muted)!important;font-family:var(--atom-font)!important;letter-spacing:0!important}.atom-number{font-family:var(--atom-font)!important;font-weight:300;letter-spacing:-2px}.atom-message{border:0;border-radius:12px;background:var(--card);padding:10px 12px}.atom-app h1{margin-bottom:14px}.atom-panel{margin:12px 0}.tag,.badge{border:0!important;border-radius:10px!important}.section-title{font-weight:600;letter-spacing:-.3px}\n@media(prefers-reduced-motion:reduce){*,*:before,*:after{transition:none!important;animation:none!important}}\n</style></head><body class=\"atom-app\"><section id=\"player\" class=\"view\"><h1>音乐播放器</h1><p class=\"atom-label\">布局示例 · 没有音源</p><div class=\"cover\" aria-hidden=\"true\">♪</div><div><strong id=\"song\">午后散步</strong><p class=\"atom-label\">示例曲目，不是真实播放</p></div><div class=\"atom-row\"><button class=\"atom-button atom-button-primary\" id=\"play\">播放说明</button><button class=\"atom-button\" id=\"open-list\">歌曲列表</button></div><p id=\"notice\" class=\"atom-message\">可以选择曲目；本模板不播放声音。</p></section><section id=\"list\" class=\"view\" hidden><div class=\"atom-row\"><button id=\"back\" class=\"atom-button\">返回</button><h1 style=\"margin:0\">示例歌曲</h1></div><p class=\"atom-label\">点击选择 · 列表可滚动</p><div id=\"songs\" class=\"atom-scroll\" data-atom-scroll></div></section><script>(function(global){'use strict';\nfunction escape(value){return String(value==null?'':value).replace(/[&<>\"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]})}\nfunction button(text,options){options=options||{};return '<button type=\"button\" class=\"atom-button'+(options.primary?' atom-button-primary':'')+'\"'+(options.id?' id=\"'+escape(options.id)+'\"':'')+(options.disabled?' disabled':'')+'>'+escape(text)+'</button>'}\nfunction label(text){return '<span class=\"atom-label\">'+escape(text)+'</span>'}\n// row accepts trusted component HTML, not arbitrary user text. Escape text first.\nfunction row(items){return '<div class=\"atom-row\">'+items.join('')+'</div>'}\nglobal.AtomUI={escape:escape,button:button,label:label,row:row};\n})(window);\nvar names=['午后散步','窗边的雨','清晨第一束光','慢慢回家','夜晚的书桌','远处的海','山间来信','城市小路','安静的车站','下一次旅行'];document.getElementById('songs').innerHTML=names.map(function(n,i){return AtomUI.button(n+' · 示例',{id:'song'+i})}).join('');names.forEach(function(n,i){document.getElementById('song'+i).onclick=function(){document.getElementById('song').textContent=n;show(false)}});function show(list){document.getElementById('player').hidden=list;document.getElementById('list').hidden=!list}document.getElementById('open-list').onclick=function(){show(true)};document.getElementById('back').onclick=function(){show(false)};document.getElementById('play').onclick=function(){document.getElementById('notice').textContent='尚未提供音源，不能播放。接入真实音频后才启用播放。'};if(window.AtomApp&&AtomApp.navigation)AtomApp.navigation.setBackHandler(function(){if(!document.getElementById('list').hidden)show(false);else AtomApp.home();});</script></body></html>",
    "icon.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><title>音乐播放器示例</title><g transform=\"translate(5 5) scale(.84)\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M28 39V19l20-4v20M28 22l20-4\" /><ellipse cx=\"23\" cy=\"42\" rx=\"6\" ry=\"4\" /><ellipse cx=\"43\" cy=\"38\" rx=\"6\" ry=\"4\" /></g></svg>"
  }
}