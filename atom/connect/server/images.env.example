# Copy to /etc/atom/images.env with root ownership and mode 0600.
ARK_API_KEY=
# Use agent-plan only with an Agent Plan dedicated key; standard uses normal API billing.
ATOM_IMAGE_API_MODE=standard
ATOM_IMAGE_MODEL=doubao-seedream-5-0-flash-260915
# Comma-separated ATOM account IDs allowed to use this deployment's billed key.
ATOM_IMAGE_ALLOWED_USERS=
