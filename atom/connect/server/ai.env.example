# Copy to /etc/atom/ai.env with root ownership and mode 0600. Restart atom-connect after changes.
# Devices without their own model key use this channel once signed in to an ATOM account.
ATOM_AI_ZHIPU_KEY=
ATOM_AI_GENERATE_MODEL=glm-4.5-air
# Per account and calendar month (UTC). Failed calls are refunded.
ATOM_AI_QUOTA_GENERATE=30
