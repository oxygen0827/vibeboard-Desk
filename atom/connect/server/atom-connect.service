[Unit]
Description=ATOM Connect relay and marketplace
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=atom
Group=atom
WorkingDirectory=/opt/atom
# Bind the Docker bridge gateway: reachable by the nginx container via host.docker.internal, not from the internet.
# Optional SMTP settings for email verification, password reset and alerts (root-only file).
EnvironmentFile=-/etc/atom/smtp.env
ExecStart=/usr/bin/python3 /opt/atom/connect/relay/server.py --host 172.17.0.1 --port 9092 --db /var/lib/atom/relay.sqlite3 --trusted-proxy 172.17.0.0/16
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/atom
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
