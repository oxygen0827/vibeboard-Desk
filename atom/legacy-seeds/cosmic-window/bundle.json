{
  "manifest": {
    "id": "cosmic-window",
    "name": "宇宙橱窗",
    "description": "火星旋转、立体轨道和黑洞吸积盘，鼠标改变观察角度",
    "entry": "index.html",
    "icon": "icon.svg",
    "layout": "fullscreen"
  },
  "files": {
    "index.html": "<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>宇宙橱窗</title><style>*{box-sizing:border-box}html,body{height:100%;margin:0;overflow:hidden;background:#080c18;color:#eff2ff;font:14px system-ui,sans-serif}canvas{display:block;width:100%;height:100%}.hud{position:absolute;top:12px;left:14px;pointer-events:none;text-shadow:0 2px 5px #000}h1{margin:0;font-size:20px;font-weight:600;letter-spacing:2px}.hud p{font-size:11px;color:#a4b4d5;margin:4px 0}.controls{position:absolute;bottom:12px;left:12px;right:12px;display:flex;gap:6px}button{min-height:44px;padding:8px 10px;background:#111b30e8;color:#b7c8e9;border:1px solid #34425d;border-radius:8px;font:14px system-ui;flex:1}button.active{background:#eab979;color:#182035;border-color:#eab979}button:focus-visible{outline:2px solid #fff}.fps{position:absolute;right:14px;top:15px;color:#a4b4d5;font:11px monospace;pointer-events:none}</style></head><body><canvas id=\"c\"></canvas><div class=\"hud\"><h1 id=\"title\">火星 · 红色荒原</h1><p id=\"caption\">移动鼠标改变视角 · 点击星球掀起尘暴</p><p>艺术化演示 · 尺寸与轨道速度未按比例</p></div><div class=\"controls\"><button class=\"active\" data-mode=\"mars\">火星</button><button data-mode=\"solar\">太阳系</button><button data-mode=\"hole\">黑洞</button><button id=\"pause\">暂停</button></div><span id=\"fps\" class=\"fps\">测量中</span><script>var c=document.getElementById('c'),g=c.getContext('2d',{alpha:false}),W=480,H=360,t=0,last=performance.now(),sample=last,frames=0,paused=false,mouse={x:240,y:180,active:false},stars=[];function rand(a,b){return a+Math.random()*(b-a)}function resize(){var r=c.getBoundingClientRect();W=c.width=Math.round(r.width);H=c.height=Math.round(r.height);stars=[];for(var i=0;i<170;i++)stars.push({x:Math.random()*W,y:Math.random()*H,z:rand(.3,1.4),seed:rand(0,6.28)})}resize();window.addEventListener('resize',resize);c.onpointermove=function(e){var r=c.getBoundingClientRect();mouse={x:e.clientX-r.left,y:e.clientY-r.top,active:true}};c.onpointerleave=function(){mouse.active=false};function sky(){g.fillStyle='#070b17';g.fillRect(0,0,W,H);var haze=g.createRadialGradient(W*.65,H*.3,0,W*.65,H*.3,W*.65);haze.addColorStop(0,'#172040');haze.addColorStop(1,'#070b17');g.fillStyle=haze;g.fillRect(0,0,W,H);stars.forEach(function(s){g.globalAlpha=.3+.5*(.5+.5*Math.sin(t*.4+s.seed));g.fillStyle='#c5dcff';g.fillRect(s.x+(mouse.x-W/2)*s.z*.008,s.y+(mouse.y-H/2)*s.z*.008,s.z,s.z)});g.globalAlpha=1}function glow(x,y,r,color){var z=g.createRadialGradient(x,y,0,x,y,r);z.addColorStop(0,color);z.addColorStop(1,'rgba(0,0,0,0)');g.fillStyle=z;g.fillRect(x-r,y-r,r*2,r*2)}function tick(now){var dt=Math.min(.05,(now-last)/1000);last=now;if(!paused)t+=dt;frames++;if(now-sample>=1000){document.getElementById('fps').textContent=Math.round(frames*1000/(now-sample))+' FPS';sample=now;frames=0}draw();requestAnimationFrame(tick)}var mode='mars',storm=0,angle=0,drag=false,dragX=0,planets=[{name:'水星',r:4,d:35,s:1.7,color:'#bca58c'},{name:'金星',r:7,d:53,s:1.1,color:'#e8b67e'},{name:'地球',r:8,d:73,s:.8,color:'#4c9eda'},{name:'火星',r:6,d:94,s:.63,color:'#c86c49'},{name:'木星',r:15,d:132,s:.32,color:'#d5b28b'},{name:'土星',r:12,d:173,s:.23,color:'#e4c28e'},{name:'天王星',r:7,d:197,s:.16,color:'#7cc7d5'},{name:'海王星',r:7,d:217,s:.12,color:'#487bd1'}];var titles={mars:['火星 · 红色荒原','拖动旋转 · 点击星球掀起尘暴'],solar:['太阳系 · 轨道剧场','移动鼠标改变轨道倾角 · 点击行星查看名称'],hole:['黑洞 · 光的边界','移动鼠标扭转吸积盘 · 点击释放能量脉冲']};document.querySelectorAll('[data-mode]').forEach(function(b){b.onclick=function(){mode=b.dataset.mode;document.querySelectorAll('[data-mode]').forEach(function(x){x.classList.toggle('active',x===b)});document.getElementById('title').textContent=titles[mode][0];document.getElementById('caption').textContent=titles[mode][1]}});document.getElementById('pause').onclick=function(){paused=!paused;this.textContent=paused?'继续':'暂停'};c.onpointerdown=function(e){drag=true;dragX=e.clientX;c.setPointerCapture(e.pointerId)};c.addEventListener('pointermove',function(e){if(drag){angle+=(e.clientX-dragX)*.012;dragX=e.clientX}});c.onpointerup=function(){drag=false;storm=1;if(mode==='solar'){var best=null,dist=28;planets.forEach(function(p){var d=Math.hypot(mouse.x-p.x,mouse.y-p.y);if(d<dist){dist=d;best=p}});if(best)document.getElementById('caption').textContent=best.name+' · 艺术化轨道，可继续观察其他行星'}};c.onpointercancel=function(){drag=false};\n// Precomputed planetary texture; sphere shading and rotation are calculated locally.\nvar N=180,tex=document.createElement('canvas');tex.width=512;tex.height=256;var tg=tex.getContext('2d'),ti=tg.createImageData(512,256);for(var y=0;y<256;y++)for(var x=0;x<512;x++){var u=x/512*6.28,v=y/256*3.14;var n=Math.sin(u*7+Math.sin(v*5))*Math.cos(v*13)+Math.sin(u*19-v*11)*.4+Math.sin(u*43+v*31)*.2;var p=(y*512+x)*4;ti.data[p]=161+n*26;ti.data[p+1]=73+n*16;ti.data[p+2]=42+n*11;ti.data[p+3]=255}tg.putImageData(ti,0,0);var sphere=document.createElement('canvas');sphere.width=sphere.height=N;var sg=sphere.getContext('2d'),im=sg.createImageData(N,N),map=[];for(var sy=0;sy<N;sy++)for(var sx=0;sx<N;sx++){var nx=(sx-N/2)/(N/2-1),ny=(sy-N/2)/(N/2-1),q=nx*nx+ny*ny;if(q<=1){var z=Math.sqrt(1-q),light=Math.max(.07,nx*-.45+ny*-.35+z*.75);map.push({p:(sy*N+sx)*4,u:Math.atan2(nx,z)/6.28+.5,v:Math.acos(-ny)/3.14,light:light,z:z})}}function mars(){var rotation=t*.035+angle/6.28;map.forEach(function(m){var tx=((Math.floor((m.u+rotation)*512)%512)+512)%512,ty=Math.min(255,Math.floor(m.v*256)),p=(ty*512+tx)*4,l=m.light;im.data[m.p]=ti.data[p]*l;im.data[m.p+1]=ti.data[p+1]*l;im.data[m.p+2]=ti.data[p+2]*l;im.data[m.p+3]=255});sg.putImageData(im,0,0);var x=W/2+(mouse.x-W/2)*.035,y=H*.48,r=104;glow(x,y,r*1.55,'rgba(224,91,41,.18)');g.drawImage(sphere,x-r,y-r,r*2,r*2);g.strokeStyle='#d8894c66';g.lineWidth=2;g.beginPath();g.arc(x,y,r,0,6.28);g.stroke();if(storm>.02){g.strokeStyle='rgba(245,171,87,'+storm*.65+')';for(var i=0;i<28;i++){var a=i*.23+t*2;g.beginPath();g.ellipse(x,y,r*(1.02+storm*.25),r*.3,a,0,.9);g.stroke()}}g.fillStyle='#f2b58b';g.font='11px monospace';g.fillText('ROTATION / '+Math.floor((rotation%1+1)%1*360)+'°',16,H-72)}function solar(){var x=W/2,y=H*.49,tilt=.35+(mouse.y/H)*.3;planets.forEach(function(p){g.strokeStyle='#34476b';g.lineWidth=.6;g.beginPath();g.ellipse(x,y,p.d,p.d*tilt,0,0,6.28);g.stroke();var a=t*p.s+p.d;p.x=x+Math.cos(a)*p.d;p.y=y+Math.sin(a)*p.d*tilt});glow(x,y,58,'rgba(255,177,50,.52)');var sun=g.createRadialGradient(x-4,y-5,0,x,y,22);sun.addColorStop(0,'#fff4be');sun.addColorStop(1,'#eb6d18');g.fillStyle=sun;g.beginPath();g.arc(x,y,21,0,6.28);g.fill();planets.slice().sort(function(a,b){return a.y-b.y}).forEach(function(p){if(p.name==='土星'){g.strokeStyle='#dac797';g.lineWidth=3;g.beginPath();g.ellipse(p.x,p.y,21,5,-.3,0,6.28);g.stroke()}var z=g.createRadialGradient(p.x-p.r*.4,p.y-p.r*.4,0,p.x,p.y,p.r);z.addColorStop(0,p.color);z.addColorStop(1,'#111724');g.fillStyle=z;g.beginPath();g.arc(p.x,p.y,p.r,0,6.28);g.fill();g.fillStyle='#aec0de';g.font='10px system-ui';g.fillText(p.name,p.x-p.r,p.y+p.r+13)})}function hole(){var x=W/2+(mouse.x-W/2)*.04,y=H*.47,tilt=.22+mouse.y/H*.22;glow(x,y,150,'rgba(136,64,32,.22)');g.save();g.translate(x,y);g.rotate((mouse.x-W/2)*.001);for(var i=0;i<56;i++){var r=48+i*1.6;g.strokeStyle='hsla('+(26+i*.33)+',95%,'+(70-i*.5)+'%,'+(.6-i*.007)+')';g.lineWidth=1.4;g.beginPath();g.ellipse(0,0,r,r*tilt,0,0,6.28);g.stroke()}for(var j=0;j<130;j++){var a=j*2.4+t*(1+(j%5)*.3),r=54+(j%45)*1.7;g.fillStyle=j%3?'#ffe1a5':'#f78339';g.fillRect(Math.cos(a)*r,Math.sin(a)*r*tilt,2,1)}g.fillStyle='#020307';g.beginPath();g.arc(0,0,37,0,6.28);g.fill();g.shadowColor='#ffbe6f';g.shadowBlur=15;g.strokeStyle='#ffe2a9';g.lineWidth=2;g.beginPath();g.arc(0,0,40,0,6.28);g.stroke();g.shadowBlur=0;g.restore();if(storm>.02){g.strokeStyle='rgba(255,218,160,'+storm+')';g.beginPath();g.ellipse(x,y,45+(1-storm)*150,(45+(1-storm)*150)*tilt,0,0,6.28);g.stroke()}}function draw(){sky();if(!paused)storm*=.965;if(mode==='mars')mars();else if(mode==='solar')solar();else hole()}requestAnimationFrame(tick);</script></body></html>",
    "icon.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><title>宇宙橱窗</title><g transform=\"translate(5 5) scale(.84)\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"32\" cy=\"32\" r=\"13\" /><ellipse cx=\"32\" cy=\"32\" rx=\"25\" ry=\"8\" transform=\"rotate(-25 32 32)\" /><path d=\"M15 12v6M12 15h6M50 45v7M47 49h7\" /></g></svg>"
  }
}
