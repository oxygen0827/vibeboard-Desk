{
  "manifest": {
    "id": "focus-studio",
    "name": "专注工作台",
    "description": "任务队列、专注与休息周期、当日统计及本机保存",
    "entry": "index.html",
    "icon": "icon.svg",
    "layout": "fullscreen"
  },
  "files": {
    "index.html": "<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>专注工作台</title><style>*{box-sizing:border-box}html,body{margin:0;height:100%;overflow:hidden}body{font:16px system-ui,sans-serif;background:var(--atom-paper,#f3f0e8);color:var(--atom-ink,#242622);padding:14px;display:flex;flex-direction:column;gap:10px}h1{font-size:22px;margin:0}p{margin:0}button,input,select{font:inherit;color:inherit}button{min-height:44px;border:1px solid var(--atom-line,#bbb);border-radius:6px;background:transparent;padding:7px 12px}button:active{background:var(--atom-line,#ddd)}button:focus-visible{outline:2px solid var(--atom-accent,#df5038)}.primary{background:var(--atom-action,#b53c28);color:var(--atom-paper,#fff);border:0}.row{display:flex;align-items:center;gap:8px}.row>*{min-width:0}.row input{flex:1;width:100%;height:44px;background:transparent;border:1px solid var(--atom-line,#bbb);padding:8px}.muted{font-size:13px;color:var(--atom-secondary-text,#62665d)}.grow{flex:1;min-height:0}.atom-scroll{overflow-y:auto;min-height:0;flex:1}.view{display:flex;flex-direction:column;gap:10px;min-height:0;flex:1}.view[hidden]{display:none}.number{font:64px ui-monospace,monospace;line-height:1.15}.bar{height:4px;background:var(--atom-line,#ddd)}.bar i{display:block;background:var(--atom-accent,#df5038);height:100%;width:0} .list-item{display:flex;gap:6px;border-bottom:1px solid var(--atom-line,#ddd);padding:6px 0;align-items:center}.list-item span{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap} .list-item button{flex-shrink:0}.center{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px}select{background:transparent;border:1px solid var(--atom-line,#bbb);height:32px}</style></head><body><section class=\"view\" id=\"focus\"><div class=\"row\"><h1 class=\"grow\">专注工作台</h1><button id=\"tasks-open\">任务</button><button id=\"stats-open\">统计</button></div><p id=\"task-name\">自由专注</p><div class=\"grow center\"><p class=\"muted\" id=\"phase\">专注</p><div id=\"time\" class=\"number\">25:00</div><p id=\"hint\" class=\"muted\">静下来，完成一件事</p></div><div class=\"bar\"><i id=\"progress\"></i></div><div class=\"row\"><button id=\"start\" class=\"primary grow\">开始</button><button id=\"reset\">重置</button><button id=\"complete\">完成任务</button></div><div class=\"row muted\"><span>专注</span><select id=\"length\" aria-label=\"专注时长\"><option value=\"25\">25分钟</option><option value=\"45\">45分钟</option><option value=\"1\">1分钟测试</option></select><span>休息5分钟 · 空格回桌面</span></div></section><section id=\"tasks\" class=\"view\" hidden><div class=\"row\"><button class=\"back\">返回</button><h1>任务队列</h1></div><div class=\"row\"><input id=\"task-input\" maxlength=\"80\" placeholder=\"下一件值得专注的事\"><button id=\"add\" class=\"primary\">添加</button></div><div id=\"task-list\" class=\"atom-scroll\"></div></section><section id=\"stats\" class=\"view\" hidden><div class=\"row\"><button class=\"back\">返回</button><h1>今日记录</h1></div><div class=\"grow center\"><p>已完成专注</p><div id=\"sessions\" class=\"number\">0</div><p id=\"minutes\"></p></div><p class=\"muted\" id=\"save-status\">正在读取本机记录…</p><button id=\"clear\">清空今日统计</button></section><script>var $=function(x){return document.getElementById(x)},data={tasks:[],seconds:1500,duration:1500,end:null,phase:'focus',days:{}},loaded=false;function store(){parent.postMessage({type:'atom:app-state',action:'set',data:data},'*')}parent.postMessage({type:'atom:app-state',action:'get'},'*');window.addEventListener('message',function(e){if(e.source!==parent||!e.data||e.data.type!=='atom:app-state-result')return;if(e.data.action==='get'){if(e.data.data&&Array.isArray(e.data.data.tasks))data=e.data.data;loaded=true;draw()}$('save-status').textContent=e.data.ok?'记录保存在本机，退出应用后计时继续':'本机保存失败'});function day(){var d=new Date();return d.getFullYear()+'-'+(d.getMonth()+1)+'-'+d.getDate()}function stats(){return data.days[day()]||(data.days[day()]={sessions:0,seconds:0})}function show(id){['focus','tasks','stats'].forEach(function(v){$(v).hidden=v!==id});draw()}function remaining(){return data.end?Math.max(0,Math.ceil((data.end-Date.now())/1000)):data.seconds}function draw(){var n=remaining();$('time').textContent=String(Math.floor(n/60)).padStart(2,'0')+':'+String(n%60).padStart(2,'0');$('phase').textContent=data.phase==='focus'?'专注':'休息';$('start').textContent=data.end?'暂停':'开始';$('task-name').textContent=data.tasks.length?data.tasks[0]:'自由专注';$('progress').style.width=(100*(1-n/data.duration))+'%';var s=stats();$('sessions').textContent=s.sessions;$('minutes').textContent='累计 '+Math.floor(s.seconds/60)+' 分钟 · 待办 '+data.tasks.length+' 项';$('length').disabled=!!data.end||data.phase!=='focus';var l=$('task-list');l.textContent='';data.tasks.forEach(function(t,i){var row=document.createElement('div');row.className='list-item';var text=document.createElement('span');text.textContent=t;var b=document.createElement('button');b.textContent=i===0?'删除':'置顶';b.onclick=function(){var t=data.tasks.splice(i,1)[0];if(i)data.tasks.unshift(t);store();draw()};row.append(text,b);l.append(row)});if(!data.tasks.length)l.textContent='没有待办任务，添加后即可开始。'}$('tasks-open').onclick=function(){show('tasks')};$('stats-open').onclick=function(){show('stats')};document.querySelectorAll('.back').forEach(function(b){b.onclick=function(){show('focus')}});$('add').onclick=function(){var t=$('task-input').value.trim();if(!t)return;if(data.tasks.length>=100){$('task-input').placeholder='最多100项任务';return}data.tasks.push(t);$('task-input').value='';store();draw()};$('task-input').onkeydown=function(e){if(e.key==='Enter')$('add').click()};$('start').onclick=function(){if(!loaded)return;if(data.end){data.seconds=remaining();data.end=null}else{if(!data.seconds)data.seconds=data.duration;data.end=Date.now()+data.seconds*1000}store();draw()};$('reset').onclick=function(){data.end=null;data.seconds=data.duration;store();draw()};$('complete').onclick=function(){if(data.tasks.length)data.tasks.shift();store();draw()};$('length').onchange=function(){data.duration=data.seconds=+this.value*60;store();draw()};$('clear').onclick=function(){if(confirm('清空今日专注统计？')){data.days[day()]={sessions:0,seconds:0};store();draw()}};setInterval(function(){if(data.end&&remaining()===0){if(data.phase==='focus'){var s=stats();s.sessions++;s.seconds+=data.duration;data.phase='rest';data.duration=300;$('hint').textContent='本轮完成，开始休息吧'}else{data.phase='focus';data.duration=+$('length').value*60;$('hint').textContent='休息结束，准备下一轮'}data.end=null;data.seconds=data.duration;store()}draw()},500);draw();</script></body></html>",
    "icon.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><title>专注工作台</title><g transform=\"translate(5 5) scale(.84)\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"32\" cy=\"32\" r=\"16\" /><circle cx=\"32\" cy=\"32\" r=\"7\" /><path d=\"M32 12v8M52 32h-8M32 52v-8M12 32h8\" /></g></svg>"
  }
}
