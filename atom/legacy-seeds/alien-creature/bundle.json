{
  "manifest": {
    "id": "alien-creature",
    "name": "异星生物",
    "description": "水母、机械花和星际蠕虫，追随鼠标并回应点击",
    "entry": "index.html",
    "icon": "icon.svg",
    "layout": "fullscreen"
  },
  "files": {
    "index.html": "<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>异星生物</title><style>*{box-sizing:border-box}html,body{height:100%;margin:0;overflow:hidden;background:#080c18;color:#eff2ff;font:14px system-ui,sans-serif}canvas{display:block;width:100%;height:100%}.hud{position:absolute;top:12px;left:14px;pointer-events:none;text-shadow:0 2px 5px #000}h1{margin:0;font-size:20px;font-weight:600;letter-spacing:2px}.hud p{font-size:11px;color:#a4b4d5;margin:4px 0}.controls{position:absolute;bottom:12px;left:12px;right:12px;display:flex;gap:6px}button{min-height:44px;padding:8px 10px;background:#111b30e8;color:#b7c8e9;border:1px solid #34425d;border-radius:8px;font:14px system-ui;flex:1}button.active{background:#eab979;color:#182035;border-color:#eab979}button:focus-visible{outline:2px solid #fff}.fps{position:absolute;right:14px;top:15px;color:#a4b4d5;font:11px monospace;pointer-events:none}</style></head><body><canvas id=\"c\"></canvas><div class=\"hud\"><h1 id=\"title\">异星生物 · 深空水母</h1><p>移动鼠标引导 · 点击激发荧光 · 无需摄像头</p></div><div class=\"controls\"><button class=\"active\" data-kind=\"jelly\">水母</button><button data-kind=\"flower\">机械花</button><button data-kind=\"worm\">星际蠕虫</button><button id=\"color\">换色</button></div><span id=\"fps\" class=\"fps\">测量中</span><script>var c=document.getElementById('c'),g=c.getContext('2d',{alpha:false}),W=480,H=360,t=0,last=performance.now(),sample=last,frames=0,paused=false,mouse={x:240,y:180,active:false},stars=[];function rand(a,b){return a+Math.random()*(b-a)}function resize(){var r=c.getBoundingClientRect();W=c.width=Math.round(r.width);H=c.height=Math.round(r.height);stars=[];for(var i=0;i<170;i++)stars.push({x:Math.random()*W,y:Math.random()*H,z:rand(.3,1.4),seed:rand(0,6.28)})}resize();window.addEventListener('resize',resize);c.onpointermove=function(e){var r=c.getBoundingClientRect();mouse={x:e.clientX-r.left,y:e.clientY-r.top,active:true}};c.onpointerleave=function(){mouse.active=false};function sky(){g.fillStyle='#070b17';g.fillRect(0,0,W,H);var haze=g.createRadialGradient(W*.65,H*.3,0,W*.65,H*.3,W*.65);haze.addColorStop(0,'#172040');haze.addColorStop(1,'#070b17');g.fillStyle=haze;g.fillRect(0,0,W,H);stars.forEach(function(s){g.globalAlpha=.3+.5*(.5+.5*Math.sin(t*.4+s.seed));g.fillStyle='#c5dcff';g.fillRect(s.x+(mouse.x-W/2)*s.z*.008,s.y+(mouse.y-H/2)*s.z*.008,s.z,s.z)});g.globalAlpha=1}function glow(x,y,r,color){var z=g.createRadialGradient(x,y,0,x,y,r);z.addColorStop(0,color);z.addColorStop(1,'rgba(0,0,0,0)');g.fillStyle=z;g.fillRect(x-r,y-r,r*2,r*2)}function tick(now){var dt=Math.min(.05,(now-last)/1000);last=now;if(!paused)t+=dt;frames++;if(now-sample>=1000){document.getElementById('fps').textContent=Math.round(frames*1000/(now-sample))+' FPS';sample=now;frames=0}draw();requestAnimationFrame(tick)}var kind='jelly',hue=185,x=W/2,y=H/2-10,pulse=0,trail=[];document.querySelectorAll('[data-kind]').forEach(function(b){b.onclick=function(){kind=b.dataset.kind;document.getElementById('title').textContent='异星生物 · '+({jelly:'深空水母',flower:'机械花',worm:'星际蠕虫'}[kind]);document.querySelectorAll('[data-kind]').forEach(function(z){z.classList.toggle('active',z===b)})}});document.getElementById('color').onclick=function(){hue=(hue+65)%360;pulse=1};c.onpointerdown=function(){pulse=1};function color(a,l){return 'hsla('+hue+',85%,'+(l||65)+'%,'+a+')'}function draw(){sky();var tx=mouse.active?mouse.x:W/2+Math.sin(t*.55)*65,ty=mouse.active?Math.min(H-85,Math.max(95,mouse.y)):H*.43+Math.cos(t*.8)*24;x+=(tx-x)*.035;y+=(ty-y)*.035;pulse*=.965;trail.unshift({x:x,y:y});if(trail.length>85)trail.pop();glow(x,y,95,color(.12+pulse*.15));g.lineCap='round';if(kind==='jelly'){for(var i=0;i<18;i++){g.beginPath();g.moveTo(x+(i-8.5)*4,y+18);for(var j=1;j<25;j++){var q=j/24,px=x+(i-8.5)*4+Math.sin(t*1.9-q*7+i*.5)*(q*22)+Math.sin(i)*q*8,py=y+18+q*(76+Math.sin(i)*20);g.lineTo(px,py)}g.strokeStyle=color(.23+.5*(i%3)/3);g.lineWidth=i%3===0?2:1;g.stroke()}var swell=1+Math.sin(t*2.8)*.08+pulse*.2;g.save();g.translate(x,y);g.scale(swell,swell);var z=g.createRadialGradient(-12,-18,0,0,0,56);z.addColorStop(0,color(.6,88));z.addColorStop(.7,color(.24));z.addColorStop(1,color(.02));g.fillStyle=z;g.beginPath();g.moveTo(-51,20);g.bezierCurveTo(-55,-63,55,-63,51,20);g.bezierCurveTo(20,2,-20,2,-51,20);g.fill();g.strokeStyle=color(.8);g.lineWidth=1.5;g.stroke();for(var k=0;k<7;k++){g.strokeStyle=color(.22);g.beginPath();g.moveTo(0,-42);g.quadraticCurveTo((k-3)*16,-12,(k-3)*15,15);g.stroke()}g.restore()}else if(kind==='flower'){for(var i=0;i<20;i++){var a=i/20*6.28+t*.12,r=53+Math.sin(t*1.5+i*.4)*15+pulse*25;g.save();g.translate(x,y);g.rotate(a);g.strokeStyle=color(.6);g.fillStyle=color(.12);g.lineWidth=1;g.beginPath();g.moveTo(12,0);g.bezierCurveTo(25,-18,r+10,-14,r,0);g.bezierCurveTo(r+10,14,25,18,12,0);g.fill();g.stroke();g.fillStyle=color(.85);g.beginPath();g.arc(r,0,2,0,6.28);g.fill();g.restore()}g.strokeStyle=color(.9);g.beginPath();g.arc(x,y,14+Math.sin(t*3)*2,0,6.28);g.stroke();g.fillStyle=color(.6);g.beginPath();g.arc(x,y,6,0,6.28);g.fill()}else{for(var i=trail.length-1;i>=0;i-=2){var q=1-i/85,p=trail[i],r=4+q*16;g.fillStyle=color(q*.7);g.strokeStyle=color(.85);g.lineWidth=1;g.beginPath();g.ellipse(p.x+Math.sin(t*3-i*.18)*5,p.y,r,r*.65,t+i*.05,0,6.28);g.fill();g.stroke()}g.fillStyle='#f5ffff';g.beginPath();g.arc(x-6,y-3,3,0,6.28);g.arc(x+6,y-3,3,0,6.28);g.fill()}for(var k=0;k<25;k++){var a=k*2.4+t*.23,r=95+Math.sin(k*6.2+t)*28;g.fillStyle=color(.3);g.fillRect(x+Math.cos(a)*r,y+Math.sin(a)*r*.65,1.5,1.5)}if(pulse>.1){g.strokeStyle=color(pulse*.65);g.beginPath();g.arc(x,y,(1-pulse)*110+20,0,6.28);g.stroke()}}requestAnimationFrame(tick);</script></body></html>",
    "icon.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 64 64\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\"><title>异星生物</title><g transform=\"translate(5 5) scale(.84)\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M16 31c0-24 32-24 32 0ZM22 32c-11 12 8 9 1 20M31 32c-8 10 6 13 0 22M41 32c10 12-8 9-1 20\" /><path d=\"M26 24v2M38 24v2\" /></g></svg>"
  }
}
