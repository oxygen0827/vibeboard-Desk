{
  "manifest": {
    "id": "particle-lab",
    "name": "粒子实验室",
    "description": "实时粒子模拟、指针引力、三种运动模式与实际帧率显示",
    "entry": "index.html",
    "icon": "icon.svg",
    "layout": "fullscreen"
  },
  "files": {
    "index.html": "<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>粒子实验室</title><style>*{box-sizing:border-box}html,body{margin:0;height:100%;overflow:hidden}body{font:16px system-ui,sans-serif;background:var(--atom-paper,#f3f0e8);color:var(--atom-ink,#242622);padding:14px;display:flex;flex-direction:column;gap:10px}h1{font-size:22px;margin:0}p{margin:0}button,input,select{font:inherit;color:inherit}button{min-height:44px;border:1px solid var(--atom-line,#bbb);border-radius:6px;background:transparent;padding:7px 12px}button:active{background:var(--atom-line,#ddd)}button:focus-visible{outline:2px solid var(--atom-accent,#df5038)}.primary{background:var(--atom-action,#b53c28);color:var(--atom-paper,#fff);border:0}.row{display:flex;align-items:center;gap:8px}.row>*{min-width:0}.row input{flex:1;width:100%;height:44px;background:transparent;border:1px solid var(--atom-line,#bbb);padding:8px}.muted{font-size:13px;color:var(--atom-secondary-text,#62665d)}.grow{flex:1;min-height:0}.atom-scroll{overflow-y:auto;min-height:0;flex:1}.view{display:flex;flex-direction:column;gap:10px;min-height:0;flex:1}.view[hidden]{display:none}.number{font:64px ui-monospace,monospace;line-height:1.15}.bar{height:4px;background:var(--atom-line,#ddd)}.bar i{display:block;background:var(--atom-accent,#df5038);height:100%;width:0} .list-item{display:flex;gap:6px;border-bottom:1px solid var(--atom-line,#ddd);padding:6px 0;align-items:center}.list-item span{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap} .list-item button{flex-shrink:0}canvas{width:100%;height:0;display:block;border-radius:6px;touch-action:none;background:#171c21}select{height:44px;background:transparent;border:1px solid var(--atom-line,#bbb);border-radius:6px;max-width:140px}.row button{flex:1}</style></head><body><div class=\"row\"><h1 class=\"grow\">粒子实验室</h1><span id=\"fps\" class=\"muted\">测量中</span></div><canvas id=\"canvas\" class=\"grow\"></canvas><div class=\"row\"><select id=\"mode\" aria-label=\"模拟模式\"><option value=\"orbit\">引力轨道</option><option value=\"rain\">星雨</option><option value=\"wave\">波场</option></select><button id=\"pause\">暂停</button><button id=\"reset\">重置</button><select id=\"count\" aria-label=\"粒子数量\"><option>120</option><option selected>300</option><option>600</option><option>1000</option></select></div><p class=\"muted\">移动鼠标改变引力中心 · 帧率是当前实测值</p><script>var c=document.getElementById('canvas'),ctx=c.getContext('2d'),particles=[],w=0,h=0,target={x:0,y:0},paused=false,last=performance.now(),sample=last,frames=0,phase=0;var $=function(x){return document.getElementById(x)};function resize(){var r=c.getBoundingClientRect();w=c.width=Math.floor(r.width);h=c.height=Math.floor(r.height);target={x:w/2,y:h/2};reset()}function reset(){particles=[];for(var i=0;i<+$('count').value;i++)particles.push({x:Math.random()*w,y:Math.random()*h,vx:(Math.random()-.5)*2,vy:(Math.random()-.5)*2,seed:Math.random()*6.28})}c.onpointermove=function(e){var r=c.getBoundingClientRect();target={x:e.clientX-r.left,y:e.clientY-r.top}};c.onpointerleave=function(){target={x:w/2,y:h/2}};$('pause').onclick=function(){paused=!paused;this.textContent=paused?'继续':'暂停'};$('reset').onclick=reset;$('count').onchange=reset;$('mode').onchange=reset;function step(now){var dt=Math.min(2,(now-last)/16.67);last=now;frames++;if(now-sample>=1000){$('fps').textContent=Math.round(frames*1000/(now-sample))+' FPS · '+particles.length+' 粒子';frames=0;sample=now}if(!paused){phase+=.02*dt;ctx.fillStyle='#171c21';ctx.fillRect(0,0,w,h);ctx.fillStyle='#e7b66b';var mode=$('mode').value;particles.forEach(function(p,i){if(mode==='orbit'){var dx=target.x-p.x,dy=target.y-p.y,d=Math.max(30,Math.sqrt(dx*dx+dy*dy));p.vx=(p.vx+(dx/d*.1-dy/d*.035)*dt)*.995;p.vy=(p.vy+(dy/d*.1+dx/d*.035)*dt)*.995;p.x+=p.vx*dt;p.y+=p.vy*dt}else if(mode==='rain'){p.x+=Math.sin(phase+p.seed)*dt;p.y+=(1.5+i%4)*dt}else{p.x=i/particles.length*w;p.y=h/2+Math.sin(p.seed+phase+i*.04)*h*.28+Math.sin(i*.02-phase)*20}if(p.x<0)p.x+=w;if(p.x>w)p.x-=w;if(p.y<0)p.y+=h;if(p.y>h)p.y-=h;ctx.fillRect(p.x,p.y,2,2)});ctx.strokeStyle='#747c84';ctx.beginPath();ctx.arc(target.x,target.y,8,0,Math.PI*2);ctx.stroke()}requestAnimationFrame(step)}resize();window.addEventListener('resize',resize);requestAnimationFrame(step);</script></body></html>",
    "icon.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" viewBox=\"0 0 64 64\"><title>粒子实验室</title><g fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" transform=\"translate(5 5) scale(.84)\"><ellipse cx=\"32\" cy=\"32\" rx=\"22\" ry=\"9\" transform=\"rotate(35 32 32)\" /><ellipse cx=\"32\" cy=\"32\" rx=\"22\" ry=\"9\" transform=\"rotate(-35 32 32)\" /><circle cx=\"32\" cy=\"32\" r=\"3\" /></g></svg>"
  }
}
