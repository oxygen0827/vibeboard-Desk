{
  "files": {
    "index.html": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n  <meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n  <style>\n    html, body {\n      height: 100%;\n      margin: 0;\n      overflow: hidden;\n      background-color: #121212;\n      color: #ffffff;\n    }\n    \n    .app-container {\n      display: grid;\n      place-content: center;\n      text-align: center;\n      height: 100%;\n      width: 100%;\n      position: relative;\n    }\n    \n    .light-container {\n      position: relative;\n      width: 300px;\n      height: 300px;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n    }\n    \n    .light {\n      width: 200px;\n      height: 200px;\n      border-radius: 50%;\n      background-color: #4285f4;\n      box-shadow: 0 0 60px 20px rgba(66, 133, 244, 0.5);\n      transition: background-color 0.5s, box-shadow 0.5s;\n      animation: breathe 4s infinite ease-in-out;\n    }\n    \n    .light.amber {\n      background-color: #fbbc05;\n      box-shadow: 0 0 60px 20px rgba(251, 188, 5, 0.5);\n    }\n    \n    @keyframes breathe {\n      0%, 100% { transform: scale(1); opacity: 0.8; }\n      50% { transform: scale(1.1); opacity: 1; }\n    }\n    \n    .controls {\n      position: absolute;\n      bottom: 60px;\n      left: 50%;\n      transform: translateX(-50%);\n      display: flex;\n      gap: 20px;\n    }\n    \n    button {\n      padding: 14px 24px;\n      border: none;\n      border-radius: 16px;\n      background-color: rgba(255, 255, 255, 0.1);\n      color: white;\n      font-size: 16px;\n      font-weight: 500;\n      cursor: pointer;\n      transition: background-color 0.2s;\n    }\n    \n    button:hover {\n      background-color: rgba(255, 255, 255, 0.2);\n    }\n    \n    button:focus {\n      outline: 2px solid var(--atom-focus-color, #4285f4);\n      outline-offset: 2px;\n    }\n    \n    .paused {\n      animation-play-state: paused;\n    }\n    \n    .header {\n      position: absolute;\n      top: 0;\n      left: 0;\n      right: 0;\n      padding: 16px;\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n    }\n    \n    .back-button {\n      width: 48px;\n      height: 48px;\n      border-radius: 50%;\n      background-color: rgba(255, 255, 255, 0.1);\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      cursor: pointer;\n      border: none;\n    }\n    \n    .back-button{padding:12px} .back-button svg {\n      width: 24px;\n      height: 24px;\n      fill: currentColor;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"app-container\">\n    <div class=\"header\">\n      <button class=\"back-button\" aria-label=\"返回桌面\" data-atom-back>\n        <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\">\n          <path d=\"M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z\"/>\n        </svg>\n      </button>\n    </div>\n    \n    <div class=\"light-container\">\n      <div class=\"light\" id=\"light\"></div>\n    </div>\n    \n    <div class=\"controls\">\n      <button id=\"toggle-btn\">暂停</button>\n      <button id=\"color-btn\">切换颜色</button>\n    </div>\n  </div>\n  \n  <script>\n    document.addEventListener('DOMContentLoaded', () => {\n      const light = document.getElementById('light');\n      const toggleBtn = document.getElementById('toggle-btn');\n      const colorBtn = document.getElementById('color-btn');\n      let isPaused = false;\n      let isAmber = false;\n      \n      // Check if reduced motion is enabled\n      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;\n      \n      // Handle back button\n      document.querySelector('.back-button').addEventListener('click', () => {\n        AtomApp.home();\n      });\n      \n      // Toggle pause/resume animation\n      toggleBtn.addEventListener('click', () => {\n        isPaused = !isPaused;\n        if (isPaused) {\n          light.classList.add('paused');\n          toggleBtn.textContent = '继续';\n        } else {\n          light.classList.remove('paused');\n          toggleBtn.textContent = '暂停';\n        }\n      });\n      \n      // Toggle light color\n      colorBtn.addEventListener('click', () => {\n        isAmber = !isAmber;\n        if (isAmber) {\n          light.classList.add('amber');\n          colorBtn.textContent = '切换为蓝色';\n        } else {\n          light.classList.remove('amber');\n          colorBtn.textContent = '切换为琥珀色';\n        }\n      });\n      \n      AtomApp.onSuspend(() => { light.classList.add('paused'); });\n      window.addEventListener('message', event => {\n        if(event.source===parent && event.data?.type==='atom:input-settings') {\n          light.style.animation=event.data.motion===false || prefersReducedMotion?'none':'';\n        }\n      });\n      // Apply reduced motion if needed\n      if (prefersReducedMotion) {\n        light.style.animation = 'none';\n      }\n    });\n  </script>\n</body>\n</html>",
